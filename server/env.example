# העתק ל-server/.env.local (לא נכנס ל-git)

# שרת
NODE_ENV=development
SERVER_HOST=127.0.0.1
SERVER_PORT=8787

# CORS — מקורות מ-front (Vite)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5175,http://127.0.0.1:5175

# Supabase (Beo OS) — אותם ערכים כמו ב-.env.local של הפרונט
SUPABASE_URL=https://valdaydyzjpwwbczwzot.supabase.co
SUPABASE_ANON_KEY=
# service_role מ-Supabase → Settings → API (רק בשרת / xCloud)
SUPABASE_SERVICE_ROLE_KEY=

# מפתח לבוט ג׳וני / צי agents — אותו ערך ב-agents.beosystem.com
BOT_API_KEY=

# ריווחית אונליין — מ«הצג API» בהגדרות ממשקים
RIVHIT_API_TOKEN=
# אופציונלי אם הזיהוי האוטומטי נכשל:
# RIVHIT_WORK_ORDER_TYPE=
# RIVHIT_TAX_RECEIPT_TYPE=
# RIVHIT_CREDIT_NOTE_TYPE=

# מנהל ראשוני
ADMIN_EMAILS=ceo@beosystem.com

# Morning (חשבונית ירוקה) — אופציונלי; בלי זה POST /api/bot-morning/documents נכשל
# MORNING_ENV=production
# MORNING_KEY_ID=
# MORNING_KEY_SECRET=

SYNC_FROM_DATE=2026-03-01
SYNC_OVERLAP_DAYS=7
