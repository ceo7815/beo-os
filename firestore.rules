rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function me() {
      return request.auth.uid;
    }

    function myRole() {
      return signedIn() &&
        exists(/databases/$(database)/documents/users/$(me()))
        ? string(get(/databases/$(database)/documents/users/$(me())).data.role)
        : '';
    }

    /** תפקידי מנהל — כולל וריאנטים נפוצים אם נשמרו עם רישיות שונה */
    function isAdmin() {
      let r = myRole();
      return r == 'admin' || r == 'superadmin' ||
        r == 'Admin' || r == 'Superadmin' ||
        r == 'ADMIN' || r == 'SUPERADMIN';
    }

    function isSelf(userId) {
      return signedIn() && me() == userId;
    }

    match /users/{userId} {
      allow read: if signedIn();
      allow create: if isAdmin() || (
        isSelf(userId) &&
        !(request.resource.data.role in ['admin', 'superadmin'])
      );
      allow update: if isAdmin() || (
        isSelf(userId) &&
        request.resource.data.diff(resource.data).changedKeys().hasOnly([
          'name',
          'avatar',
          'color',
          'email'
        ])
      );
      allow delete: if isAdmin();
    }

    match /tasks/{taskId} {
      allow read: if signedIn() && (
        isAdmin() ||
        resource.data.assigneeId == me() ||
        resource.data.createdBy == me()
      );
      allow create: if signedIn() && request.resource.data.createdBy == me();
      allow update, delete: if signedIn() && (
        isAdmin() ||
        resource.data.assigneeId == me() ||
        resource.data.createdBy == me()
      );

      match /activity/{activityId} {
        allow read, write: if signedIn();
      }
      match /taskNotes/{noteId} {
        allow read, write: if signedIn();
      }
    }

    match /attendancePresence/{userId} {
      allow read: if isAdmin() || isSelf(userId);
      allow create, update, delete: if isAdmin() || isSelf(userId);
    }

    match /attendanceLogs/{logId} {
      allow read: if signedIn() && (isAdmin() || resource.data.userId == me());
      allow create: if signedIn() && (isAdmin() || request.resource.data.userId == me());
      allow update, delete: if signedIn() && (isAdmin() || resource.data.userId == me());
    }

    match /checkIns/{checkInId} {
      allow read: if signedIn() && (isAdmin() || resource.data.userId == me());
      allow create: if signedIn() && (isAdmin() || request.resource.data.userId == me());
      allow update, delete: if isAdmin();
    }

    match /attendanceAnomalies/{anomalyId} {
      allow read: if signedIn() && (isAdmin() || resource.data.userId == me());
      allow create, update, delete: if isAdmin();
    }

    match /activityLogs/{activityId} {
      allow read: if signedIn() && (isAdmin() || resource.data.userId == me());
      allow create: if signedIn() && (isAdmin() || request.resource.data.userId == me());
      allow update, delete: if isAdmin();
    }

    match /attendanceConfig/{configId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    /** לידים — עדכון מצד הלקוח חייב ללא ערכי `undefined` (Firestore דוחה). */
    match /leads/{leadId} {
      allow read, write: if signedIn();
    }

    /** מודולי Hub — כל משתמש מחובר (כמו ה-catch-all בעבר). מפורש כדי שלא יישברו אם יש בעיה ב-glob של ה-catch-all. */
    match /clients/{id} {
      allow read, write: if signedIn();
    }
    match /projects/{id} {
      allow read, write: if signedIn();
    }
    match /suppliers/{id} {
      allow read, write: if signedIn();
    }
    match /campaigns/{id} {
      allow read, write: if signedIn();
    }
    match /invoices/{id} {
      allow read, write: if signedIn();
    }
    match /collectionTracking/{id} {
      allow read, write: if signedIn();
    }
    match /hostingRecords/{id} {
      allow read, write: if signedIn();
    }
    match /domainRecords/{id} {
      allow read, write: if signedIn();
    }
    match /docs/{id} {
      allow read, write: if signedIn();
    }
    match /recurringTaskTemplates/{id} {
      allow read, write: if signedIn();
    }

    /**
     * כספת סיסמאות: אדמינים — קריאה/עריכה מלאה.
     * עובד — קריאה רק אם ה-uid שלו ב-visibleUserIds (ריק = רק אדמין).
     * יצירת פריט: משתמש מחובר + עצמו ב-visibleUserIds (או אדמין).
     * עדכון/מחיקה: אדמין בלבד.
     */
    match /passwords_vault/{entryId} {
      allow read: if isAdmin() || (
        signedIn() &&
        resource.data.visibleUserIds is list &&
        me() in resource.data.visibleUserIds
      );
      allow create: if signedIn() && (
        isAdmin() ||
        (
          request.resource.data.updatedBy == me() &&
          request.resource.data.visibleUserIds is list &&
          me() in request.resource.data.visibleUserIds
        )
      );
      allow update, delete: if isAdmin();
    }

    /**
     * שאר נתיבים: משתמש מחובר, למעט כספת הסיסמאות (שם רק החוקים למעלה).
     * Path מ-{name=**} הוא טיפוס Path — יש להמיר ל-string לפני matches (אחרת אזהרת קומפילר / permission-denied).
     */
    match /{anyPath=**} {
      allow read, write: if signedIn() &&
        !string(anyPath).matches('^(.*/)?passwords_vault(/.*)?$');
    }
  }
}
