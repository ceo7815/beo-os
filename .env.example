# Hub POS — משתני סביבה ל-build (Vite)
# העתק ל-.env.local לפיתוח מקומי, או הגדר ב-xCloud לפני docker compose build.
# חשוב: VITE_* נטמעים ב-bundle בזמן build — שינוי דורש rebuild.

# --- Firebase (חובה) ---
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=hub-pos-f399c.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=hub-pos-f399c
VITE_FIREBASE_STORAGE_BUCKET=hub-pos-f399c.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=961483294937
VITE_FIREBASE_APP_ID=1:961483294937:web:765583ea55dc05cfa416c8

# --- Firebase Functions (אופציונלי) ---
# אזור Cloud Functions — ברירת מחדל us-central1
VITE_FUNCTIONS_REGION=us-central1

# --- אינטגרציות (אופציונלי) ---
# URL ל-Clockify proxy (Firebase Callable) — רק אם שונה מברירת המחדל
# VITE_CLOCKIFY_PROXY_URL=

# קישור לחשבונית ירוקה / Morning בדף גבייה
VITE_GREEN_INVOICE_URL=https://www.greeninvoice.co.il/

# --- פיתוח בלבד — אל תפעיל בפרודקשן ---
VITE_ENABLE_FIRESTORE_SEED=false

# --- API server (xCloud / Docker Compose) ---
# הרץ: node scripts/encode-firebase-sa.mjs path/to/service-account.json
# FIREBASE_SERVICE_ACCOUNT_B64=
# CORS_ORIGINS=https://pos.hub.co.il
