# Beo OS — משתני סביבה ל-build (Vite)
# העתק ל-.env.local לפיתוח מקומי.
# חשוב: VITE_* נטמעים ב-bundle בזמן build — שינוי דורש restart של Vite.

# --- Supabase (Beo OS בלבד — אין Firebase / Firestore) ---
VITE_SUPABASE_URL=https://valdaydyzjpwwbczwzot.supabase.co
VITE_SUPABASE_ANON_KEY=

# --- API server ---
# CORS_ORIGINS=http://localhost:5173,http://localhost:5175

# --- אינטגרציות (אופציונלי) ---
VITE_GREEN_INVOICE_URL=https://www.greeninvoice.co.il/

# --- צי Beo-agents (פרוקסי Vite בלבד) ---
# ברירת מחדל ב-vite.config: https://agents.beosystem.com
# BEO_AGENTS_TARGET=http://127.0.0.1:8788
